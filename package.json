{
  "name": "mojo-plugin-mqtt-helper",
  "version": "0.7.1",
  "description": "Adds an MQTT client helper to mojo.js",
  "keywords": [
    "mojojs",
    "mqtt",
    "iot"
  ],
  "type": "module",
  "author": "Daniel Mantovani <dmanto@cpan.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmanto/mojo-plugin-mqtt-helper.git"
  },
  "bugs": {
    "url": "https://github.com/dmanto/mojo-plugin-mqtt-helper/issues"
  },
  "scripts": {
    "build": "pnpm exec tsc --build ./",
    "build:clean": "run-s clean build",
    "build:coverage": "run-s build coverage",
    "build:lint": "run-s build lint",
    "build:test": "run-s build test tsd",
    "build:oltest": "run-s build oltest",
    "build:watch": "pnpm run build -- --watch",
    "build:inspect": "run-s build \"inspect {1}\" --",
    "clean": "rimraf tsconfig.tsbuildinfo lib",
    "coverage": "c8 node --test test/basic.js test/broker-connection.js",
    "coverage:ci": "run-p -r mqtt-test-server mqtt-test-coverage:ci",
    "prelint": "prettier -c --cache .",
    "lint": "eslint \"test/*.js\" \"test-d/*.test-d.ts\" \"src/**/*.ts\" \"src/*.ts\" \"examples/**/*.js\"",
    "prelint:fix": "prettier -w --cache .",
    "lint:fix": "pnpm run lint",
    "tsd": "tsd",
    "oltest": "run-p -r mqtt-test-server mqtt-test-client",
    "mqtt-test-server": "node test/support/mqtt-server.js",
    "mqtt-test-client": "cross-env MQTT_TEST_ONLINE=mqtt://localhost:61883 node --test test/basic.js test/broker-connection.js",
    "mqtt-test-coverage:ci": "cross-env MQTT_TEST_ONLINE=mqtt://localhost:61883 c8 --reporter lcovonly node --test test/basic.js test/broker-connection.js",
    "prepublishOnly": "pnpm run build",
    "publish:minor": "pnpm version minor && pnpm publish",
    "publish:patch": "pnpm version patch && pnpm publish",
    "inspect": "run-p -r mqtt-test-server \"inspect-mqtt-test-client {1}\" --",
    "inspect-mqtt-test-client": "cross-env MQTT_TEST_ONLINE=mqtt://localhost:61883 node --inspect",
    "test": "node --test test/basic.js test/broker-connection.js"
  },
  "exports": "./lib/mojo-plugin-mqtt-helper.js",
  "types": "./lib/mojo-plugin-mqtt-helper.d.ts",
  "files": [
    "lib/"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.71.0",
    "aedes": "^1.2.0",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "rimraf": "^6.0.1",
    "tsd": "^0.33.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">= 24"
  },
  "dependencies": {
    "mqtt-pool": "^0.1.2"
  },
  "peerDependencies": {
    "@mojojs/core": "^1.26.6",
    "mqtt": "^5.10.1"
  }
}
